# ===========================================================================
#  SUI example — "Flow Field"
#  A generative GPU simulation: a framebuffer-feedback shader drags the previous
#  frame along a smooth noise field and deposits streaks, so particles flow and
#  leave fading trails that recolour as they move. The sidebar controls it.
#
#  Run:  python box.py examples/flow.sui
# ===========================================================================

# ------ colors ------
BG =            (9, 15, 17, 255)
PANEL =         (18, 28, 30, 255)
PANEL_LIGHT =   (30, 44, 46, 255)
ACCENT =        (237, 163, 90, 255)
ACCENT_SOFT =   (254, 232, 217, 255)
TEXT =          (235, 240, 235, 255)
MUTED =         (150, 170, 168, 255)
LINE =          (6, 46, 48, 255)

# ------ simulation state + shader-facing helpers ------
@python
FLOW = {
    "n": 260, "speed": 1.6, "fade": 0.93,
    "alive": True, "clearframes": 0, "t": 0.0,
}

def flow_toggle(box):
    FLOW["alive"] = not FLOW["alive"]
    return True

def flow_clear(box):
    FLOW["clearframes"] = 2     # fade out over 2 frames -> wipes the GPU trails
    FLOW["t"] = 0.0
    return True

def flow_n(box, d):
    FLOW["n"] = max(40, min(4000, int(FLOW["n"] + d)))
    return True

def flow_speed(box, d):
    FLOW["speed"] = max(0.2, min(9.0, FLOW["speed"] + float(d)))
    return True

def flow_preset(box, idx):
    if idx == 0:
        FLOW.update({"scale": 0.004, "speed": 1.4, "fade": 0.93})
    elif idx == 1:
        FLOW.update({"scale": 0.009, "speed": 3.6, "fade": 0.90})
    else:
        FLOW.update({"scale": 0.0014, "speed": 0.7, "fade": 0.96})
    return True

# live readouts + shader-facing values
def density_label():
    return "%d" % FLOW["n"]
def speed_label():
    return "%.1f" % FLOW["speed"]
def flow_speed_val():
    return FLOW["speed"] * 0.22
def flow_density_val():
    return max(0.6, min(2.5, FLOW["n"] / 300.0))
def flow_fade():
    if FLOW["clearframes"] > 0:
        FLOW["clearframes"] -= 1
        return 0.0
    return FLOW.get("fade", 0.93)
def flow_paused():
    return 1 if (not FLOW["alive"]) else 0
def flow_status():
    return "%s  %d particles  %.1f speed" % (
        "flowing" if FLOW["alive"] else "paused", FLOW["n"], FLOW["speed"])
@end

# ------ default styling ------
[4-default]:
	.color=BG
	.border_color=LINE
	.text_color=TEXT
	.horizontal
	.padding=8
	.margin=4
	.border=0
	.radius=10
	.align_x=left
	.align_y=top

[1-root]:
	.vertical
	.margin=0
	.padding=0
	.radius=0
	[16-header]:
		.color=PANEL
		.horizontal
		.padding=8
		.radius=0
		[1-head-title]:
			.color=None
			.vertical
			.align_y=center
			.strength=30
			[1-head-name]:
				.text="FLOW FIELD"
				.color=None
				.align_x=center
				.padding=0
			[1-head-status]:
				.text=calc(flow_status())
				.color=None
				.text_color=ACCENT
				.align_x=center
				.padding=0
		[1-head-eq]:
			.anim=assets/anim
			.anim_fps=18
			.texture_fit=cover
			.color=None
			.border=2
			.strength=22
	[88-body]:
		.horizontal
		.padding=0
		.margin=0
		.radius=0
		[26-sidebar]:
			.vertical
			.scroll
			.color=PANEL
			.padding=10
			.margin=0
			.radius=0
			[1-note]:
				.color=None
				.text_color=MUTED
				.text="CONTROLS"
				.padding=2
			# primary buttons — bp.* share styling, each keeps text/click
			[1-bp.play]:
				.text=calc("Pause" if FLOW["alive"] else "Play")
				.color=ACCENT
				.hover_color=ACCENT_SOFT
				.selected_color=LINE
				.padding=14
				.margin=4
				.radius=10
				.align_x=center
				.text_color=LINE
				.click=flow_toggle(bp.play)
			[1-bp.clear]:
				.text="Clear"
				.click=flow_clear(bp.clear)
			[1-sep]:
				.color=BG
				.strength=2
			[1-param-label]:
				.color=None
				.text_color=ACCENT
				.text="DENSITY"
				.padding=6
			# row.* share layout; bs.* share pill styling; val.* share readout styling
			[1-row.density]:
				.horizontal
				.color=None
				.padding=4
				[1-bs.minus]:
					.text="Fewer"
					.color=PANEL_LIGHT
					.hover_color=ACCENT
					.padding=12
					.margin=3
					.radius=10
					.align_x=center
					.text_color=TEXT
					.click=flow_n(bs.minus, -60)
				[1-val.density]:
					.color=None
					.text_color=ACCENT
					.align_x=center
					.strength=25
					.text=calc(density_label())
				[1-bs.plus]:
					.text="More"
					.click=flow_n(bs.plus, 60)
			[1-param-label2]:
				.color=None
				.text_color=ACCENT
				.text="SPEED"
				.padding=6
			[1-row.speed]:
				.horizontal
				.color=None
				.padding=4
				[1-bs.slow]:
					.text="Slower"
					.click=flow_speed(bs.slow, -0.6)
				[1-val.speed]:
					.color=None
					.text_color=ACCENT
					.align_x=center
					.strength=25
					.text=calc(speed_label())
				[1-bs.fast]:
					.text="Faster"
					.click=flow_speed(bs.fast, 0.6)
			[1-sep2]:
				.color=BG
				.strength=2
			[1-param-label3]:
				.color=None
				.text_color=ACCENT
				.text="PRESETS"
				.padding=6
			[1-bs.storm]:
				.text="Storm"
				.click=flow_preset(bs.storm, 1)
			[1-bs.frost]:
				.text="Frost"
				.click=flow_preset(bs.frost, 2)
			[1-bs.bloom]:
				.text="Bloom"
				.click=flow_preset(bs.bloom, 0)
		[74-canvas]:
			.vertical
			.color=BG
			.padding=0
			.margin=0
			.radius=0
			[1-stage]:
				.color=None
				.padding=0
				.margin=0
				.radius=0
				.shader=shaders/flow.frag
				.speed=calc(flow_speed_val())
				.pause=calc(flow_paused())
				.intensity=calc(flow_density_val())
				.fade=calc(flow_fade())