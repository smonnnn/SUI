# ===========================================================================
#  SUI example — "Shadertop"
#  A live GPU shader as the wallpaper of a little interface. Every widget is a
#  translucent box on top of the shader, so the animation shows through.
#  Buttons call python callbacks; the title bar has a live clock.
#
#  Run:  python box.py examples/shadertop.sui
# ===========================================================================

@python
import datetime

def clk():
    return datetime.datetime.now().strftime("%H:%M:%S")

STATE = {"n": 0}

def bump(box, d):
    STATE["n"] += int(d)
    return True

def count():
    return "clicks  %d" % STATE["n"]
@end

# ------ colors ------
BG =      (10, 18, 20, 255)
TEXT =    (240, 244, 240, 255)
ACCENT =  (120, 210, 235, 255)
DARK =    (10, 24, 26, 255)
BAR =     (18, 30, 34, 160)     # translucent top bar
CARD =    (18, 30, 34, 130)     # translucent card
PILL =    (10, 24, 26, 140)     # translucent counter strip
APP =     (30, 60, 70, 90)      # translucent app pill
FOOT =    (18, 30, 34, 120)     # translucent footer

[1-root]:
	.vertical
	.margin=0
	.padding=0
	[1-wallpaper]:
		.shader=shaders/waves.frag
		.color=BG
		.padding=0
		.margin=0
		.border=0
		.radius=0
		.vertical
		[1-topbar]:
			.horizontal
			.color=BAR
			.padding=12
			.margin=0
			.radius=0
			[1-title]:
				.color=None
				.text_color=TEXT
				.text="SHADERTOP"
				.padding=0
				.margin=0
				.strength=50
			[1-clock]:
				.color=None
				.text_color=ACCENT
				.text=calc(clk())
				.align_x=right
				.padding=0
				.strength=30
		[1-apps]:
			.horizontal
			.color=None
			.padding=14
			[1-app.a]:
				.text="GALLERY"
				.color=APP
				.text_color=TEXT
				.padding=16
				.margin=6
				.radius=12
				.align_x=center
			[1-app.b]:
				.text="PLAYLIST"
				.click=bump(app.b, 1)
			[1-app.c]:
				.text="SETTINGS"
				.click=bump(app.c, 1)
		[1-card]:
			.color=CARD
			.margin=14
			.radius=14
			.strength=60
			.vertical
			[1-card-title]:
				.color=None
				.text_color=ACCENT
				.text="LIVE WAVES"
				.padding=10
				.margin=4
			[1-card-body]:
				.color=None
				.text_color=TEXT
				.text="Every widget here is a translucent box floating over a GPU fragment shader (Waves by @XorDev). The clock is calc(clk()), the counter is a python callback, and the wallpaper is one .shader= line."
				.padding=14
				.margin=4
			[1-counter]:
				.horizontal
				.color=PILL
				.padding=10
				.margin=6
				.radius=12
				[1-pill.m]:
					.text="-1"
					.color=ACCENT
					.text_color=DARK
					.padding=12
					.margin=4
					.radius=10
					.align_x=center
					.click=bump(pill.m, -1)
				[1-score]:
					.color=None
					.text_color=TEXT
					.align_x=center
					.strength=40
					.text=calc(count())
				[1-pill.p]:
					.text="+1"
					.click=bump(pill.p, 1)
		[1-foot]:
			.color=FOOT
			.padding=10
			.align_x=center
			.strength=20
			.text="SUI - declarative raylib UI"