# ===========================================================================
#  SUI example — "Minimal"
#  A tiny but complete layout: a responsive header (hidden on narrow windows
#  via calc(ratio < 1.0)), a shared-group sidebar, and pages swapped with
#  set_children(swap, content.X). Shows off the guide's basics.
#
#  Run:  python box.py examples/test_layout_2.sui
# ===========================================================================

# ------ colors ------
BACKGROUND =    (202, 220, 174, 255)
FOREGROUND =    (225, 233, 201, 255)
PANEL =         (240, 246, 226, 255)
BUTTON =        (237, 163, 90, 255)
BUTTON_H =      (254, 232, 217, 255)
BORDER =        (0, 34, 34, 255)
TEXT =          (0, 34, 34, 255)
MUTED =         (110, 130, 118, 255)

# ------ python helpers ------
@python
import datetime

def clk():
    return datetime.datetime.now().strftime("%H:%M:%S")

STATE = {"n": 0}

def bump(box, d):
    STATE["n"] += int(d)
    return True

def count():
    return "clicks %d" % STATE["n"]
@end

# ------ default styling inherited by every box ------
[10-default]:
	.text=""
	.color=FOREGROUND
	.border_color=BORDER
	.hidden=False
	.horizontal
	.padding=0
	.margin=5
	.border=0
	.text_color=TEXT

[1-root]:
	[1-layout]:
		.color=BACKGROUND
		.vertical
		.margin=0
		[10-header]:
			.color=PANEL
			.horizontal
			.border=1
			.radius=12
			.hidden=calc(ratio < 1.0)
			[1-head-title]:
				.text="A cool header :)"
				.color=None
				.strength=50
			[1-head-clock]:
				.text=calc(clk())
				.color=None
				.text_color=MUTED
				.align_x=right
				.strength=30
		[90-body]:
			.color=None
			.horizontal=calc(ratio > 1.0)
			.margin=0
			.padding=0
			[20-sidebar]:
				.color=PANEL
				.vertical
				.radius=12
				.padding=8
				# item.* share styling; each keeps its own text/click
				[10-item.home]:
					.text="Home"
					.margin=1
					.padding=1
					.color=BUTTON
					.radius=8
					.click=set_children(swap, content.home)
				[10-item.contact]:
					.text="Contact"
					.click=set_children(swap, content.contact)
				[10-item.research]:
					.text="Research"
					.click=set_children(swap, content.research)
				[70-empty]:
					.color=None
					.hidden=calc(ratio < 1.0)
			[80-swap]:
				.color=None
				[1-content.home]:
					.color=BACKGROUND
					.vertical
					.padding=16
					.radius=14
					[1-welcome]:
						.text="Welcome! Click a nav button to explore."
						.color=None
						.padding=8
					[1-counter]:
						.horizontal
						.color=PANEL
						.padding=12
						.radius=12
						[1-ctr.minus]:
							.text="-1"
							.color=BUTTON
							.text_color=TEXT
							.padding=12
							.margin=4
							.radius=10
							.align_x=center
							.click=bump(ctr.minus, -1)
						[1-score]:
							.text=calc(count())
							.color=None
							.text_color=MUTED
							.align_x=center
							.strength=30
						[1-ctr.plus]:
							.text="+1"
							.click=bump(ctr.plus, 1)

[1-content.contact]:
	.color=BACKGROUND
	.vertical
	.padding=16
	.radius=14
	[1-title]:
		.text="Who am I?"
		.color=None
		.padding=6
	[1-text]:
		.text="My name is Simon, I like to reinvent the wheel. Feel free to add me on X: @Kinker_0"
		.color=None

[1-content.research]:
	.color=BACKGROUND
	.vertical
	.padding=16
	.radius=14
	[1-title]:
		.text="Research"
		.color=None
		.padding=6
	[1-text]:
		.text="Nothing here yet :)"
		.color=None