# ===========================================================================
#  SUI example — "Glassurf" / "Lens Control"
#  The Waves shader is a live wallpaper; on top, a row of lens buttons each
#  refRACT the animation behind them (a convex bulge, prismatic rim, specular
#  sheen that tracks the mouse). Clicking a lens bumps the counter via a python
#  callback.
#
#  Run:  python box.py examples/glassurf.sui
# ===========================================================================

@python
import datetime

def clk():
    return datetime.datetime.now().strftime("%H:%M:%S")

STATE = {"n": 0, "frost": 0.0, "opacity": 0.55}

def clampv(v, lo, hi):
    return max(lo, min(hi, v))

def bump(box, d):
    STATE["n"] = int(clampv(STATE["n"] + int(d), 0, 60))
    return True

def count():
    return "refraction  %d" % STATE["n"]

def refn():
    return STATE["n"]

def set_frost(box, d):
    STATE["frost"] = round(clampv(STATE["frost"] + float(d), 0.0, 1.0), 2)
    return True

def frost_val():
    return STATE["frost"]

def frost_label():
    return "frost %d%%" % round(STATE["frost"] * 100)

def set_opacity(box, d):
    STATE["opacity"] = round(clampv(STATE["opacity"] + float(d), 0.1, 0.95), 2)
    return True

def opacity_val():
    return STATE["opacity"]

def opacity_label():
    return "opacity %d%%" % round(STATE["opacity"] * 100)
@end

# ------ colors ------
BG =            (10, 18, 20, 255)
TEXT =          (240, 244, 240, 255)
ACCENT =        (120, 210, 235, 255)
DARK =          (10, 24, 26, 255)

[1-root]:
	.vertical
	.margin=0
	.padding=0
	[1-wallpaper]:
		.shader=shaders/waves.frag
		.color=BG
		.padding=0
		.margin=0
		.border=0
		.radius=0
		.vertical
		[2-topbar]:
			.horizontal
			.color=(14, 26, 30, 150)
			.padding=12
			.margin=0
			.radius=0
			[50-title]:
				.color=None
				.text_color=TEXT
				.text="LENS CONTROL"
				.padding=0
				.margin=0
			[30-clock]:
				.color=None
				.text_color=ACCENT
				.text=calc(clk())
				.align_x=right
				.padding=0
				.margin=0
		[20-card]:
			.shader=shaders/glass.frag
			.color=None
			.refrac=calc(refn())
			.frost=calc(frost_val())
			.opacity=calc(opacity_val())
			.margin=14
			.radius=14
			.vertical
			[5-cardbody]:
				.color=None
				.text_color=(0, 0, 0, 240)
				.text="This shader inspired by apple's liquid glass reflects and refracts light just like a glass lens would. Just set the .shader="glass.frag"."
				.padding=25
				.margin=4
		[8-controls]:
			.vertical
			.color=(14, 26, 30, 160)
			.margin=14
			.radius=14
			.padding=10
			[1-controls.title]:
				.color=None
				.text_color=ACCENT
				.text="SETTINGS"
				.padding=4
			[1-row.refract]:
				.horizontal
				.color=None
				.padding=6
				[30-label.refract]:
					.text="Refraction"
					.color=None
					.text_color=TEXT
					.align_y=center
				[5-minus.refract]:
					.text="-"
					.color=ACCENT
					.text_color=DARK
					.padding=0
					.margin=4
					.radius=10
					.align_x=center
					.align_y=center
					.click=bump(minus.refract, -1)
				[30-val.refract]:
					.color=None
					.text_color=TEXT
					.align_x=center
					.align_y=center
					.text=calc(count())
				[5-plus.refract]:
					.text="+"
					.color=ACCENT
					.text_color=DARK
					.padding=0
					.margin=4
					.radius=10
					.align_x=center
					.align_y=center
					.click=bump(plus.refract, 1)
			[1-row.frost]:
				[30-label.frost]:
					.text="Frost"
				[5-minus.frost]:
					.click=set_frost(minus.frost, -0.12)
				[30-val.frost]:
					.text=calc(frost_label())
				[5-plus.frost]:
					.click=set_frost(plus.frost, 0.12)
			[1-row.opacity]:
				[30-label.opacity]:
					.text="Opacity"
				[5-minus.opacity]:
					.click=set_opacity(minus.opacity, -0.10)
				[30-val.opacity]:
					.text=calc(opacity_label())
				[5-plus.opacity]:
					.click=set_opacity(plus.opacity, 0.10)
